{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZone": "Europe/Warsaw"
  },
  "Jwt": {
    "Issuer": "fitit",
    "Audience": "fitit-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Account": {
    "MinimumAge": 16,
    "ResetCodeMinutes": 15,
    "ResetCodeAttempts": 5,
    "ResetRequestsPerHour": 3
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "PasswordResetPer15Minutes": 10,
    "ReportsPerHour": 10
  },
  "Providers": {
    "LocationSearch": "OpenMeteo",
    "Weather": "OpenMeteo",
    "ImageStorage": "S3",
    "BackgroundRemover": "Fake",
    "GarmentTagger": "Fake",
    "OutfitStylist": "Fake",
    "OutfitCritic": "Fake",
    "OutfitVisualizer": "Fake",
    "ColorAnalyst": "Fake",
    "Email": "Fake"
  },
  "Visualization": {
    "PollIntervalSeconds": 3,
    "TimeLimitSeconds": 180,
    "FakePollsBeforeDone": 2
  },
  "Proxy": {
    "ForwardLimit": 1
  },
  "Weather": {
    "HotFrom": 25,
    "WarmFrom": 18,
    "MildFrom": 11,
    "ColdFrom": 3,
    "ThermalShift": 3,
    "RainProbability": 50,
    "RainMm": 1,
    "LayersAmplitude": 8,
    "DayEndHour": 22,
    "DayStartHour": 7
  },
  "Limits": {
    "ItemsPerDay": 50,
    "SuggestionsPerDay": 20,
    "VisualizationsPerDay": 5,
    "ColorAnalysesPerDay": 3,
    "TipsPerDay": 20,
    "AiBudgetUsdPerDay": 10
  },
  "Storage": {
    "Jurisdiction": "eu",
    "Bucket": "fitit",
    "Region": "auto",
    "MaxUploadBytes": 2000000
  }
}
