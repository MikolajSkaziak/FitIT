{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "TimeZone": "Europe/Warsaw"
  },
  "Jwt": {
    "Issuer": "fitit",
    "Audience": "fitit-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Account": {
    "MinimumAge": 16
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimits": {
    "AuthPerMinute": 10
  },
  "Providers": {
    "LocationSearch": "OpenMeteo",
    "ImageStorage": "S3",
    "BackgroundRemover": "Fake",
    "GarmentTagger": "Fake"
  },
  "Limits": {
    "ItemsPerDay": 50,
    "SuggestionsPerDay": 20,
    "VisualizationsPerDay": 5,
    "AiBudgetUsdPerDay": 10
  },
  "Storage": {
    "Bucket": "fitit",
    "Region": "auto",
    "MaxUploadBytes": 2000000
  }
}
