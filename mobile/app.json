{
  "expo": {
    "name": "fitit.",
    "slug": "fitit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pl.fitit.app",
      "supportsTablet": false
    },
    "android": {
      "package": "pl.fitit.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#2F5D4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#121815"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "fitit. uses your location to check the weather and suggest outfits that suit it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "fitit. needs your photos so you can add clothes to your wardrobe.",
          "cameraPermission": "fitit. uses the camera so you can take photos of your clothes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
