# Copy to .env (which is git-ignored) and adjust. Docker Compose reads it automatically.

# PostgreSQL in the local container
POSTGRES_DB=fitit
POSTGRES_USER=fitit
POSTGRES_PASSWORD=fitit
POSTGRES_PORT=5432

# API container (profile "full")
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# At least 32 bytes. Generate with: openssl rand -base64 48
# Empty is accepted only in Development, where the API makes a key for the current run.
JWT_SIGNING_KEY=
# Public address of the API, used in links to silhouette pictures. Empty: the address of each request.
PUBLIC_BASE_URL=

# File storage on a developer's machine: a local container speaking the S3 protocol, standing in for R2
STORAGE_PORT=9000
# 127.0.0.1 keeps it to this computer. Use 0.0.0.0 to upload photos from a real phone on the same network.
STORAGE_BIND=127.0.0.1
STORAGE_ACCESS_KEY=fitit-local
STORAGE_SECRET_KEY=fitit-local-secret
# The address phones use to reach storage (signed upload and picture addresses are made for it).
STORAGE_PUBLIC_URL=http://localhost:9000

# AI provider keys (Google Gemini, fal.ai). Leave empty here. On a developer machine the keys live in .NET user
# secrets (see docs/dostawcy.md), never in a file of this repository; in production they come from the environment.
Gemini__ApiKey=
Fal__ApiKey=

# File storage in production: Cloudflare R2. Leave Storage__Endpoint unset and give the account id instead;
# the API builds https://<account>.eu.r2.cloudflarestorage.com from it. See docs/r2.md for how to get these.
# Storage__AccountId=
# Storage__Jurisdiction=eu
# Storage__Bucket=fitit
# Storage__AccessKey=
# Storage__SecretKey=
