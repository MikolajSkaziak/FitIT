# Copy to .env (which is git-ignored) and adjust. Docker Compose reads it automatically.

# PostgreSQL in the local container
POSTGRES_DB=fitit
POSTGRES_USER=fitit
POSTGRES_PASSWORD=fitit
POSTGRES_PORT=5432

# API container (profile "full")
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# At least 32 bytes. Generate with: openssl rand -base64 48
# Empty is accepted only in Development, where the API makes a key for the current run.
JWT_SIGNING_KEY=
# Public address of the API, used in links to silhouette pictures. Empty: the address of each request.
PUBLIC_BASE_URL=
