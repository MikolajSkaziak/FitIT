# Template for the production env file. Copy it OUTSIDE the repository on the server and fill it in:
#
#   cp deploy/.env.example /etc/fitit/fitit.env && chmod 600 /etc/fitit/fitit.env      (as the deploy user)
#
# Rules: one NAME=value per line, no quotes, no spaces around "=", no trailing comments. Every placeholder contains the
# text CHANGE_ME, so `grep -n CHANGE_ME /etc/fitit/fitit.env` must print nothing before the first start.
# Compose reads this file (deploy/compose.yml maps each name to a configuration key of the API); backup.sh and restore.sh read it too.

# ---------------------------------------------------------------- Public address and certificates

# Host name of the API, without scheme. Its DNS A (and AAAA) record must point at this VM before the first start.
# Also becomes App__PublicBaseUrl=https://<DOMAIN> (links to silhouette pictures).
DOMAIN=CHANGE_ME.example.com
# Contact address for Let's Encrypt (expiry warnings). Caddy global option "email".
ACME_EMAIL=CHANGE_ME@example.com

# ---------------------------------------------------------------- PostgreSQL

# Database and user created by the postgres image on the first start (POSTGRES_DB, POSTGRES_USER).
# Used by the API in ConnectionStrings__Database. Changing them later does not rename an existing database.
POSTGRES_DB=fitit
POSTGRES_USER=fitit
# POSTGRES_PASSWORD, also placed in ConnectionStrings__Database. Letters and digits only: the value is embedded in a
# connection string, where ; and = have a meaning. Generate: openssl rand -hex 24
# Only used when the volume is first created: changing it later needs ALTER USER inside the database.
POSTGRES_PASSWORD=CHANGE_ME

# Jwt__SigningKey. HMAC key for access tokens, at least 32 bytes (the API refuses to start with less, and the placeholder
# is too short on purpose). Generate: openssl rand -base64 48
# Changing it signs everybody out of their current access tokens (they renew through the refresh token).
JWT_SIGNING_KEY=CHANGE_ME

# Database__MigrateOnStartup. true: the API applies EF Core migrations when it starts.
DATABASE_MIGRATE_ON_STARTUP=true

# App__TimeZone. Time zone in which a "day" starts for daily limits, ages and wear dates (IANA name).
APP_TIMEZONE=Europe/Warsaw

# ---------------------------------------------------------------- File storage: Cloudflare R2 (S3 protocol)

# Storage__Endpoint. https://<account-id>.r2.cloudflarestorage.com
# For a bucket created with the EU jurisdiction (spec section 12) it is https://<account-id>.eu.r2.cloudflarestorage.com
# Phones receive signed addresses on this same host, so it must be the S3 endpoint, not a custom domain.
STORAGE_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
# Storage__Bucket. The bucket for photos, created by hand (the API never creates it in production). Storage__Region is fixed to "auto".
STORAGE_BUCKET=fitit-files
# Storage__AccessKey and Storage__SecretKey. An R2 API token with "Object Read & Write" on this one bucket only.
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------- Providers (Providers__*)

# "OpenMeteo" or "Fake".
PROVIDER_LOCATION_SEARCH=OpenMeteo
# "OpenMeteo" or "Fake".
PROVIDER_WEATHER=OpenMeteo
# Providers__ImageStorage is fixed to "S3" in compose.yml.
# AI providers. "Fake" stands in for each (deterministic, nothing leaves the server). In Production the API refuses
# fakes unless ALLOW_FAKES_IN_PRODUCTION=true. The real ones: "Fal" for the background remover and the visualizer,
# "Gemini" for the tagger, stylist, critic and colour analyst. See docs/dostawcy.md.
PROVIDER_BACKGROUND_REMOVER=Fake
PROVIDER_GARMENT_TAGGER=Fake
PROVIDER_OUTFIT_STYLIST=Fake
PROVIDER_OUTFIT_CRITIC=Fake
PROVIDER_COLOR_ANALYST=Fake
PROVIDER_OUTFIT_VISUALIZER=Fake
# Gemini__ApiKey and Fal__ApiKey. Paste the keys ONLY into the real env file on the server (outside the repository),
# never here. The API will not start when a provider above is "Gemini" or "Fal" and its key is empty.
GEMINI_API_KEY=
FAL_API_KEY=
# Providers__AllowFakesInProduction
ALLOW_FAKES_IN_PRODUCTION=true

# ---------------------------------------------------------------- Limits (optional; values below equal appsettings.json)

# Limits__ItemsPerDay, Limits__SuggestionsPerDay, Limits__VisualizationsPerDay: per person per day.
LIMIT_ITEMS_PER_DAY=50
LIMIT_SUGGESTIONS_PER_DAY=20
LIMIT_VISUALIZATIONS_PER_DAY=5
# Limits__AiBudgetUsdPerDay. Spending cap for all AI calls together, in USD per day.
LIMIT_AI_BUDGET_USD_PER_DAY=10
# RateLimits__AuthPerMinute. Sign-in, registration and refresh attempts per minute per visitor address.
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---------------------------------------------------------------- Jobs dashboard (optional)

# Hangfire__DashboardUser and Hangfire__DashboardPassword. Leave EMPTY to switch the dashboard off (recommended).
# Caddy returns 404 for /hangfire from the internet either way; README.md explains how to reach it through an SSH tunnel.
HANGFIRE_DASHBOARD_USER=
HANGFIRE_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------- Backups (read by backup.sh and restore.sh only)

# Where nightly dumps are kept on the VM (server-setup.sh creates this directory for the deploy user).
BACKUP_DIR=/var/backups/fitit
# Local dumps older than this many days are deleted.
BACKUP_KEEP_DAYS=14
# Optional copy to a SECOND R2 bucket (not the photo bucket) with its own API token ("Object Read & Write" on that bucket only).
# Leave BACKUP_R2_BUCKET empty to keep backups on the VM only. Needs rclone on the VM (server-setup.sh installs it).
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=db/
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=
# Optional: a URL (for example from healthchecks.io) that backup.sh calls after a successful run, and with /fail appended
# after a failed one. An unreachable or silent URL is how you learn the nightly backup stopped. Leave empty to skip.
BACKUP_PING_URL=
